# Keep the build image in lockstep with runtimeImage in main.go.
FROM envoyproxy/envoy:v1.40.2@sha256:8de97e654644827d62afdbf7e1d3dc9fee01a8690d410dd1c63a30dc6b6cecbb

# Set the working directory inside the container
WORKDIR /app

# COPY sources must stay under builder/: the CLI-owned build renders this recipe
# into an output_directory that holds only builder/, and builds it with that
# directory as the context. A COPY that reaches a service file outside builder/
# builds under the legacy in-agent path but fails under the recipe path.
COPY builder/envoy.yaml /app/envoy.yaml

# Change the permissions of the file to be readable by all users
RUN chmod 644 /app/envoy.yaml

# Expose the port Envoy runs on
EXPOSE 8080

# Command to run Envoy
CMD ["envoy", "-c", "/app/envoy.yaml"]
