{
    "version": 3,
    "port": {{ .routing.port }},
    "extra_config": {{ marshal .routing.extra_config}},
    "endpoints": [
        {{- $restCount := 0 }}
        {{- if .routing.rest_group }}
        {{- $restCount = len .routing.rest_group }}
        {{- end }}
        {{- $grpcCount := 0 }}
        {{- if .routing.grpc_group }}
        {{- $grpcCount = len .routing.grpc_group }}
        {{- end }}
        {{- $total := add $restCount $grpcCount }}
        {{- $count := 0 }}
        {{- if .routing.rest_group }}
        {{- range $route := .routing.rest_group }}
        {{- $count = add $count 1 }}
        {
            "endpoint": "{{ $route.endpoint }}",
            "method": "{{ $route.method }}",
            "input_headers": [
                {{- range $idx, $header := $route.input_headers }}
                {{- if $idx}},{{end}}
                "{{ $header }}"
                {{- end }}
            ],
            "backend": [
                {
                    "url_pattern": "{{ $route.backend.url_pattern }}",
                    "host": [
                        {{- range $idx, $host := $route.backend.hosts }}
                        {{- if $idx}},{{end}}
                        "{{ $host }}"
                        {{- end }}
                    ]
                }
            ],
            "extra_config": {{ marshal $route.extra_config}}
        }
        {{- if lt $count $total }},{{end}}
        {{- end }}
        {{- end }}
        {{- if .routing.grpc_group }}
        {{- range $route := .routing.grpc_group }}
        {{- $count = add $count 1 }}
        {
            "endpoint": "{{ $route.endpoint }}",
            "output_encoding": "no-op",
            "backend": [
                {
                    "url_pattern": "{{ $route.backend.url_pattern }}",
                    "encoding": "grpc",
                    "host": [
                        {{- range $idx, $host := $route.backend.hosts }}
                        {{- if $idx}},{{end}}
                        "{{ $host }}"
                        {{- end }}
                    ]
                }
            ],
            "extra_config": {{ marshal $route.extra_config}}
        }
        {{- if lt $count $total }},{{end}}
        {{- end }}
        {{- end }}
    ]
}
